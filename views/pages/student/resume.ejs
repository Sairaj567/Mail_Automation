<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/resume.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="student-layout">
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <i class="fas fa-graduation-cap"></i>
                    <span>PlacementPortal</span>
                </div>
            </div>
            
            <nav class="sidebar-nav">
                <a href="/student/dashboard" class="nav-item">
                    <i class="fas fa-home"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/student/profile" class="nav-item">
                    <i class="fas fa-user"></i>
                    <span>Profile</span>
                </a>
                <a href="/student/jobs" class="nav-item">
                    <i class="fas fa-briefcase"></i>
                    <span>Job Listings</span>
                </a>
                <a href="/student/applications" class="nav-item">
                    <i class="fas fa-file-alt"></i>
                    <span>My Applications</span>
                </a>
                <a href="/student/resume" class="nav-item active">
                    <i class="fas fa-file-pdf"></i>
                    <span>My Resume</span>
                </a>
                <a href="/auth/logout" class="nav-item logout">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </a>
            </nav>
        </aside>

        <main class="main-content">
            <header class="content-header">
                <div class="header-left">
                    <h1>My Resume</h1>
                    <p>Upload and manage your resume for job applications</p>
                </div>
                <div class="header-right">
                    <div class="user-info">
                        <div class="user-avatar">
                            <i class="fas fa-user-graduate"></i>
                        </div>
                        <span class="user-name"><%= user.name %></span>
                    </div>
                </div>
            </header>

            <div class="resume-content">
                <!-- Resume Status Card -->
                <div class="resume-status-card">
                    <div class="status-header">
                        <div class="status-icon">
                            <i class="fas fa-file-pdf"></i>
                        </div>
                        <div class="status-info">
                            <h3>Resume Status</h3>
                            <p>Keep your resume updated for better job opportunities</p>
                        </div>
                    </div>
                    
                    <div class="status-details">
                        <% if (profile && profile.resume) { %>
                            <div class="status-item success">
                                <i class="fas fa-check-circle"></i>
                                <span>Resume Uploaded</span>
                            </div>
                            <div class="status-item">
                                <strong>File:</strong> <%= profile.resume %>
                            </div>
                            <div class="status-item">
                                <strong>Last Updated:</strong> Just now
                            </div>
                            <div class="status-item">
                                <strong>Used in:</strong> <%= applicationCount || 0 %> applications
                            </div>
                        <% } else { %>
                            <div class="status-item warning">
                                <i class="fas fa-exclamation-triangle"></i>
                                <span>No Resume Uploaded</span>
                            </div>
                            <div class="status-item">
                                Upload your resume to start applying for jobs
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Upload Resume Section -->
                <div class="upload-section">
                    <div class="section-header">
                        <h2><%= profile && profile.resume ? 'Update Your Resume' : 'Upload Your Resume' %></h2>
                        <p>Supported format: PDF (Max 5MB)</p>
                    </div>

                    <div class="upload-area" id="uploadArea">
                        <div class="upload-placeholder">
                            <i class="fas fa-cloud-upload-alt"></i>
                            <h4>Drag & Drop your resume here</h4>
                            <p>or</p>
                            <button class="btn-primary" id="browseBtn">Browse Files</button>
                            <input type="file" id="resumeFile" accept=".pdf" style="display: none;">
                        </div>
                        <div class="upload-progress" style="display: none;">
                            <div class="progress-bar">
                                <div class="progress-fill"></div>
                            </div>
                            <p>Uploading... <span class="progress-text">0%</span></p>
                        </div>
                    </div>

                    <div class="upload-requirements">
                        <h4>Resume Requirements:</h4>
                        <ul>
                            <li><i class="fas fa-check"></i> File must be in PDF format</li>
                            <li><i class="fas fa-check"></i> Maximum file size: 5MB</li>
                            <li><i class="fas fa-check"></i> Include your contact information</li>
                            <li><i class="fas fa-check"></i> Highlight relevant skills and experience</li>
                            <li><i class="fas fa-check"></i> Keep it to 1-2 pages for best results</li>
                        </ul>
                    </div>
                </div>

                <div class="preview-section">
                    <div class="section-header">
                        <h2>Resume Library</h2>
                        <p>Maintain multiple resumes for different roles</p>
                    </div>
                    <% if (resumes && resumes.length > 0) { %>
                        <div style="display:grid; gap:0.75rem;">
                            <% resumes.forEach(item => { %>
                                <div style="display:flex; justify-content:space-between; align-items:center; background:var(--light-gray); border-radius:10px; padding:0.9rem 1rem;">
                                    <div>
                                        <strong><%= item.title %></strong>
                                        <div style="font-size:0.82rem; color:#64748b;"><%= item.filename %></div>
                                    </div>
                                    <div style="display:flex; gap:0.5rem; align-items:center;">
                                        <% if (item.isPrimary) { %>
                                            <span class="status-item success" style="padding:0.35rem 0.55rem;">Primary</span>
                                        <% } else { %>
                                            <button type="button" class="btn-secondary set-primary-btn" data-resume-id="<%= item._id %>">Set Primary</button>
                                        <% } %>
                                        <button type="button" class="btn-secondary rename-resume-btn" data-resume-id="<%= item._id %>" data-resume-title="<%= item.title %>">Rename</button>
                                        <a class="btn-secondary" href="/uploads/resumes/<%= encodeURIComponent(item.filename) %>" target="_blank" rel="noopener noreferrer">View</a>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p style="color:#64748b;">No resumes uploaded yet.</p>
                    <% } %>
                </div>

                <!-- Resume Preview Section -->
                <% if (profile && profile.resume) { %>
                <div class="preview-section">
                    <div class="section-header">
                        <h2>Resume Preview</h2>
                        <div class="preview-actions">
                            <button class="btn-secondary" id="downloadBtn">
                                <i class="fas fa-download"></i> Download
                            </button>
                            <button class="btn-secondary" id="replaceBtn">
                                <i class="fas fa-sync"></i> Replace
                            </button>
                            <button class="btn-danger" id="deleteBtn">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </div>
                    </div>

                    <div class="resume-preview">
                        <div class="preview-placeholder">
                            <i class="fas fa-file-pdf"></i>
                            <h4><%= profile.resume %></h4>
                            <p>PDF Document</p>
                            <button class="btn-primary" id="viewPreviewBtn">
                                <i class="fas fa-eye"></i> View Preview
                            </button>
                        </div>
                        
                        <!-- PDF Preview Container -->
                        <div class="pdf-preview" id="pdfPreview" style="display: none;">
                            <div class="pdf-controls">
                                <button class="btn-secondary" id="prevPage">
                                    <i class="fas fa-chevron-left"></i> Previous
                                </button>
                                <span class="page-info">Page <span id="currentPage">1</span> of <span id="totalPages">1</span></span>
                                <button class="btn-secondary" id="nextPage">
                                    Next <i class="fas fa-chevron-right"></i>
                                </button>
                                <button class="btn-secondary" id="closePreview">
                                    <i class="fas fa-times"></i> Close
                                </button>
                            </div>
                            <canvas id="pdfCanvas"></canvas>
                        </div>
                    </div>
                </div>
                <% } %>

                <!-- Resume Builder Section -->
                <div class="builder-section">
                    <div class="section-header">
                        <h2>Build Your Resume</h2>
                        <p>Create a professional resume using our builder</p>
                    </div>

                    <div class="builder-options">
                        <div class="builder-card builder-card-ai">
                            <div class="builder-icon">
                                <i class="fas fa-magic"></i>
                            </div>
                            <h4>AI Resume Builder</h4>
                            <p>Generate a professional resume automatically from your profile</p>
                            <button class="btn-primary builder-action builder-action-ai" id="aiBuilderBtn">
                                <i class="fas fa-robot"></i> Generate with AI
                            </button>
                        </div>

                        <div class="builder-card builder-card-template">
                            <div class="builder-icon">
                                <i class="fas fa-edit"></i>
                            </div>
                            <h4>Template Builder</h4>
                            <p>Choose from professional templates and customize</p>
                            <button class="btn-primary builder-action builder-action-template" id="templateBuilderBtn">
                                <i class="fas fa-palette"></i> Choose Template
                            </button>
                        </div>

                        <div class="builder-card builder-card-upload">
                            <div class="builder-icon">
                                <i class="fas fa-upload"></i>
                            </div>
                            <h4>Upload Existing</h4>
                            <p>Already have a resume? Upload it directly</p>
                            <button class="btn-primary builder-action builder-action-upload" id="uploadExistingBtn">
                                <i class="fas fa-file-upload"></i> Upload Resume
                            </button>
                        </div>
                    </div>
                </div>

                <div class="builder-section">
                    <div class="section-header">
                        <h2>AI Resume Assistant</h2>
                        <p>Review and generate role-focused resume content</p>
                    </div>
                    <div class="builder-options">
                        <div class="builder-card" style="text-align:left;">
                            <h4>AI Resume Reviewer</h4>
                            <div class="input-group full-width" style="margin-bottom:0.8rem;">
                                <label for="reviewTargetRole">Target Role</label>
                                <input id="reviewTargetRole" type="text" placeholder="e.g., Frontend Developer">
                            </div>
                            <div class="input-group full-width" style="margin-bottom:0.8rem;">
                                <label for="resumeReviewFile">Resume PDF</label>
                                <input id="resumeReviewFile" type="file" accept="application/pdf">
                                <small>Select a PDF to review, or leave it empty to review your saved primary resume.</small>
                            </div>
                            <button class="btn-primary" id="runAiReviewBtn">Run AI Review</button>
                            <pre id="aiReviewOutput" style="white-space:pre-wrap; margin-top:0.8rem; background:#f8fafc; padding:0.75rem; border-radius:8px; display:none;"></pre>
                        </div>
                        <div class="builder-card" style="text-align:left;">
                            <h4>AI Resume Builder</h4>
                            <div class="input-group full-width" style="margin-bottom:0.8rem;">
                                <label for="buildTargetRole">Target Role</label>
                                <input id="buildTargetRole" type="text" placeholder="e.g., Backend Engineer">
                            </div>
                            <div class="input-group full-width" style="margin-bottom:0.8rem;">
                                <label for="buildNotes">Extra Notes</label>
                                <textarea id="buildNotes" rows="7" placeholder="Add achievements, projects, certifications you want emphasized..."></textarea>
                            </div>
                            <button class="btn-primary" id="runAiBuildBtn">Generate Resume Draft</button>
                            <pre id="aiBuildOutput" style="white-space:pre-wrap; margin-top:0.8rem; background:#f8fafc; padding:0.75rem; border-radius:8px; display:none;"></pre>
                        </div>
                    </div>
                </div>

                <!-- Resume Analytics -->
                <div class="analytics-section">
                    <div class="section-header">
                        <h2>Resume Analytics</h2>
                        <p>Track how your resume performs</p>
                    </div>

                    <div class="analytics-grid">
                        <div class="analytic-card">
                            <div class="analytic-icon">
                                <i class="fas fa-eye"></i>
                            </div>
                            <div class="analytic-info">
                                <h3>--</h3>
                                <p>Resume Views (Tracking Pending)</p>
                            </div>
                        </div>

                        <div class="analytic-card">
                            <div class="analytic-icon">
                                <i class="fas fa-briefcase"></i>
                            </div>
                            <div class="analytic-info">
                                <h3><%= typeof applicationCount !== 'undefined' ? applicationCount : 0 %></h3>
                                <p>Applications Sent</p>
                            </div>
                        </div>

                        <div class="analytic-card">
                            <div class="analytic-icon">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div class="analytic-info">
                                <h3>--</h3>
                                <p>Offer Rate (Tracking Pending)</p>
                            </div>
                        </div>

                        <div class="analytic-card">
                            <div class="analytic-icon">
                                <i class="fas fa-star"></i>
                            </div>
                            <div class="analytic-info">
                                <h3><%= typeof profileMatchScore !== 'undefined' ? profileMatchScore : 0 %>%</h3>
                                <p>Profile Match Score (Estimate)</p>
                            </div>
                        </div>
                    </div>
                    <% if (suggestedRoles && suggestedRoles.length > 0) { %>
                        <div style="margin-top:1rem;">
                            <strong>Suggested roles based on your profile:</strong>
                            <div style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-top:0.6rem;">
                                <% suggestedRoles.forEach(role => { %>
                                    <span class="skill-tag"><%= role %></span>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </main>
    </div>

    <!-- PDF.js Library for PDF preview -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js"></script>
    <script type="application/json" id="resume-data"><%- JSON.stringify({
        hasResume: Boolean(profile && profile.resume),
        resumeFilename: profile && profile.resume ? profile.resume : null,
        resumes: resumes || []
    }) %></script>
    <script src="/js/resume.js"></script>
</body>
</html>